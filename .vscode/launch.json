{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run VulkanTutorial",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/vulkan/my_code/build/VulkanTutorial/VulkanTutorial",
            "args": [],
            "cwd": "${workspaceFolder}/vulkan/my_code",
            "preLaunchTask": "cmake-build",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
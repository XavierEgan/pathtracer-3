{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-S", ".",
                "-DCMAKE_TOOLCHAIN_FILE=${env:HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake"
            ],
            "options": {
                "cwd": "${workspaceFolder}/vulkan/my_code"
            },
            "group": "build"
        },
        {
            "label": "cmake-build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--parallel"],
            "options": {
                "cwd": "${workspaceFolder}/vulkan/my_code"
            },
            "dependsOn": "cmake-configure",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}